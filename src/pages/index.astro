      }
      .portal-place { color: #0e3b27; background: #e89b2e; padding: 0.35rem 0.7rem; border-radius: 6px; font-weight: 600; }

      /* Final CTA */
      .final {
        background-color: #0e3b27;
        background-size: cover;
        background-position: center;
        color: #f7f6f2;
      }
      .final .center-head { margin-bottom: 0; }
      .final-note { font-size: 0.75rem; letter-spacing: 0.12em; opacity: 0.8; margin-top: 2rem; }

      /* Footer */
      .foot { background: #1e2a24; color: #f7f6f2; padding: 1.6rem 0; }
      .foot-inner { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; align-items: center; }
      .foot p { margin: 0; font-size: 0.9rem; }
      .foot-contact { display: flex; gap: 1.4rem; align-items: center; }
      .foot-contact a { color: #f7f6f2; text-decoration: none; font-weight: 600; }
      .foot-contact a:hover { color: #e89b2e; text-decoration: underline; text-underline-offset: 3px; }
      .foot .mono { font-size: 0.72rem; letter-spacing: 0.1em; opacity: 0.8; }

      /* ============================================================
         MOTION & EFFECTS SYSTEM  (palette-locked; degrades gracefully)
         ============================================================ */

      /* Scroll-reveal — directional + staggered */
      .reveal {
        opacity: 0; transform: translateY(34px);
        transition: opacity 0.7s cubic-bezier(.22,.61,.36,1),
                    transform 0.7s cubic-bezier(.22,.61,.36,1);
        transition-delay: var(--reveal-delay, 0ms);
        will-change: opacity, transform;
      }
      .reveal.r-left  { transform: translateX(-46px); }
      .reveal.r-right { transform: translateX(46px); }
      .reveal.r-scale { transform: scale(.9); }
      .reveal.r-blur  { filter: blur(10px); }
      .reveal.in-view { opacity: 1; transform: none; filter: none; }

      /* Scroll progress bar */
      .scroll-progress {
        position: fixed; top: 0; left: 0; height: 3px; width: 100%;
        transform: scaleX(var(--sp, 0)); transform-origin: 0 50%;
        background: linear-gradient(90deg, #175239, #e89b2e);
        z-index: 100; pointer-events: none;
      }

      /* Hero: 3D aurora background */
      .hero { perspective: 1200px; }
      .hero-aurora {
        position: absolute; inset: 0; z-index: 1; overflow: hidden;
        pointer-events: none; transform-style: preserve-3d;
      }
      .hero-aurora .blob {
        position: absolute; border-radius: 50%; filter: blur(60px);
        opacity: .55; mix-blend-mode: screen; will-change: transform;
        animation: blobFloat 18s ease-in-out infinite;
      }
      .hero-aurora .b1 { width: 46vw; height: 46vw; left: -6vw; top: -10vw;
        background: radial-gradient(circle at 30% 30%, #2f8f63, #175239 60%, transparent 72%); }
      .hero-aurora .b2 { width: 40vw; height: 40vw; right: -8vw; top: 6vw;
        background: radial-gradient(circle at 60% 40%, #e89b2e, #b06900 55%, transparent 72%);
        opacity: .42; animation-duration: 22s; animation-delay: -6s; }
      .hero-aurora .b3 { width: 34vw; height: 34vw; left: 30vw; bottom: -14vw;
        background: radial-gradient(circle at 50% 50%, #3aa172, #0e3b27 60%, transparent 74%);
        animation-duration: 26s; animation-delay: -12s; }
      .hero-grid {
        position: absolute; inset: -2px; opacity: .16;
        background-image:
          linear-gradient(rgba(247,246,242,.25) 1px, transparent 1px),
          linear-gradient(90deg, rgba(247,246,242,.25) 1px, transparent 1px);
        background-size: 46px 46px;
        mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, #000 30%, transparent 75%);
        animation: gridDrift 40s linear infinite;
      }
      .hero-inner { z-index: 2; }
      @keyframes blobFloat {
        0%,100% { transform: translate3d(0,0,0) scale(1); }
        33%     { transform: translate3d(3vw,-2vw,0) scale(1.08); }
        66%     { transform: translate3d(-2vw,2vw,0) scale(.96); }
      }
      @keyframes gridDrift { to { background-position: 46px 46px, 46px 46px; } }

      /* 3D tilt cards (JS adds --rx/--ry/--gx/--gy on pointer) */
      .tilt {
        transform: perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg)) translateZ(0);
        transition: transform .3s cubic-bezier(.22,.61,.36,1), box-shadow .3s ease, opacity .7s ease;
        transform-style: preserve-3d; position: relative;
      }
      .tilt::after {
        content: ''; position: absolute; inset: 0; border-radius: inherit;
        background: radial-gradient(240px circle at var(--gx,50%) var(--gy,0%),
                    rgba(247,246,242,.35), transparent 60%);
        opacity: 0; transition: opacity .3s ease; pointer-events: none; z-index: 3;
      }
      .tilt.is-tilting { box-shadow: 0 26px 60px rgba(14,59,39,.28); }
      .tilt.is-tilting::after { opacity: 1; }

      /* Advanced buttons — sheen sweep + lift + press */
      .btn { position: relative; overflow: hidden; isolation: isolate; }
      .btn::before {
        content: ''; position: absolute; top: 0; left: -120%; width: 60%; height: 100%;
        background: linear-gradient(100deg, transparent, rgba(247,246,242,.55), transparent);
        transform: skewX(-18deg); transition: left .6s ease; z-index: 1;
      }
      .btn:hover::before { left: 140%; }
      .btn:active { transform: translateY(0) scale(.98); }
      .btn-amber { box-shadow: 0 6px 18px rgba(232,155,46,.28); }
      .btn-amber:hover { box-shadow: 0 12px 30px rgba(232,155,46,.42); }

      /* Parallax layers */
      [data-parallax] { will-change: transform; }

      /* Animated pipeline flow */
      .pipe-flow { stroke-dasharray: 6 8; animation: dashFlow 1.2s linear infinite; }
      @keyframes dashFlow { to { stroke-dashoffset: -28; } }
      .pipeline svg { transition: transform .4s ease; }

      /* Portal + PO gentle float */
      .float-soft { animation: floatSoft 7s ease-in-out infinite; }
      @keyframes floatSoft { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

      /* Final CTA — fixed-background parallax (desktop, motion-safe) */
      @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
        .final { background-attachment: fixed; }
      }

      /* Billing toggle (monthly / annual) */
      .bill-toggle {
        display: flex; justify-content: center; gap: 0;
        width: max-content; margin: 0 auto 2.2rem;
        background: #0e3b27; border-radius: 999px; padding: 5px;
        box-shadow: inset 0 2px 6px rgba(0,0,0,.25);
      }
      .bt-opt {
        appearance: none; border: 0; cursor: pointer;
        background: transparent; color: rgba(247,246,242,.75);
        font-size: 0.8rem; letter-spacing: 0.1em; font-weight: 500;
        padding: 0.6rem 1.4rem; border-radius: 999px;
        display: inline-flex; align-items: center; gap: 0.5rem;
        transition: background .25s ease, color .25s ease;
      }
      .bt-opt:hover { color: #f7f6f2; }
      .bt-opt.is-active { background: #e89b2e; color: #0e3b27; font-weight: 600; }
      .bt-opt:focus-visible { outline: 2px solid #e89b2e; outline-offset: 2px; }
      .bt-save {
        font-size: 0.62rem; letter-spacing: 0.08em; font-weight: 700;
        background: #175239; color: #f7f6f2;
        padding: 0.18rem 0.5rem; border-radius: 999px;
      }
      .bt-opt.is-active .bt-save { background: #0e3b27; }
      @media (max-width: 480px) {
        .bt-opt { padding: 0.55rem 0.9rem; font-size: 0.72rem; }
        .bt-save { display: none; }
      }

      /* Price note under each tier price */
      .price-note { font-size: 0.72rem; letter-spacing: 0.05em; color: #175239; opacity: .85; margin: -0.4em 0 0.8em; min-height: 1.1em; }

      /* Price swap micro-animation */
      .price-swap { animation: priceSwap .35s cubic-bezier(.22,.61,.36,1); }
      @keyframes priceSwap {
        0% { opacity: 0; transform: translateY(8px) scale(.96); }
        100% { opacity: 1; transform: none; }
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal { opacity: 1; transform: none; filter: none; transition: none; }
        .hero-aurora .blob, .hero-grid, .pipe-flow, .float-soft, .price-swap { animation: none; }
        .scroll-progress { display: none; }
        .tilt, .btn::before, [data-parallax] { transition: none; transform: none; }
        .btn:hover::before { left: -120%; }
      }
    </style>
  </body>
</html>
