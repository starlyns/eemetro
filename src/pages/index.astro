    <!-- ============ SCRIPTS ============ -->
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const hasIO = 'IntersectionObserver' in window;

      // Scroll reveal — with per-group stagger
      const revealEls = document.querySelectorAll('.reveal');
      const groups = new Map();
      revealEls.forEach((el) => {
        const p = el.parentElement;
        const arr = groups.get(p) || [];
        arr.push(el);
        groups.set(p, arr);
      });
      groups.forEach((arr) => {
        if (arr.length > 1) arr.forEach((el, i) => el.style.setProperty('--reveal-delay', i * 90 + 'ms'));
      });
      if (reduceMotion || !hasIO) {
        revealEls.forEach((el) => el.classList.add('in-view'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in-view');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15 }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // Count-up numbers in the purchase order
      const fmt = (n) => n.toLocaleString('en-US');
      const counters = document.querySelectorAll('.count');
      const setFinal = (el) => (el.textContent = fmt(Number(el.dataset.count)));

      if (reduceMotion || !('IntersectionObserver' in window)) {
        counters.forEach(setFinal);
      } else {
        const animate = (el) => {
          const target = Number(el.dataset.count);
          const dur = 1200;
          const t0 = performance.now();
          const tick = (t) => {
            const p = Math.min((t - t0) / dur, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = fmt(Math.round(target * eased));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const co = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                animate(e.target);
                co.unobserve(e.target);
              }
            }
          },
          { threshold: 0.6 }
        );
        counters.forEach((el) => co.observe(el));
      }

      // ============ BILLING TOGGLE (monthly / annual) ============
      const btOpts = document.querySelectorAll('.bill-toggle .bt-opt');
      if (btOpts.length) {
        const prices = document.querySelectorAll('.js-price');
        const notes = document.querySelectorAll('.js-price-note');
        const buys = document.querySelectorAll('.js-buy');
        const apply = (term) => {
          btOpts.forEach((b) => {
            const on = b.dataset.term === term;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-pressed', String(on));
          });
          prices.forEach((p) => {
            const val = term === 'a' ? p.dataset.aPrice : p.dataset.mPrice;
            if (!reduceMotion) {
              p.classList.remove('price-swap');
              void p.offsetWidth; // restart animation
              p.classList.add('price-swap');
            }
            p.firstChild.textContent = val;
          });
          notes.forEach((n) => (n.textContent = term === 'a' ? n.dataset.aNote : n.dataset.mNote));
          buys.forEach((a) => (a.href = term === 'a' ? a.dataset.aLink : a.dataset.mLink));
        };
        btOpts.forEach((b) => b.addEventListener('click', () => apply(b.dataset.term)));
      }

      // ============ RICH MOTION (skipped entirely under reduced-motion) ============
      if (!reduceMotion) {
        const root = document.documentElement;

        /* Parallax targets: explicit [data-parallax] + section figures */
        const parallaxEls = [];
        document.querySelectorAll('[data-parallax]').forEach((el) =>
          parallaxEls.push({ el, speed: parseFloat(el.dataset.parallax) || 0.12 })
        );
        document.querySelectorAll('.split figure').forEach((el) =>
          parallaxEls.push({ el, speed: 0.06 })
        );

        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const scrollable = root.scrollHeight - root.clientHeight;
            const y = window.scrollY || root.scrollTop || 0;
            root.style.setProperty('--sp', scrollable > 0 ? y / scrollable : 0);
            const vh = window.innerHeight;
            for (const { el, speed } of parallaxEls) {
              const r = el.getBoundingClientRect();
              const center = r.top + r.height / 2 - vh / 2;
              el.style.transform = 'translate3d(0,' + (-center * speed).toFixed(1) + 'px,0)';
            }
            ticking = false;
          });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        onScroll();

        /* Hero pointer parallax (aurora field + content shift for depth) */
        const hero = document.querySelector('.hero');
        const depthEls = hero ? hero.querySelectorAll('[data-depth]') : [];
        if (hero && depthEls.length) {
          hero.addEventListener('pointermove', (ev) => {
            const r = hero.getBoundingClientRect();
            const dx = (ev.clientX - r.left) / r.width - 0.5;
            const dy = (ev.clientY - r.top) / r.height - 0.5;
            depthEls.forEach((el) => {
              const d = parseFloat(el.dataset.depth) || 0;
              el.style.transform =
                'translate3d(' + (-dx * d).toFixed(2) + 'px,' + (-dy * d).toFixed(2) + 'px,0)';
            });
          });
          hero.addEventListener('pointerleave', () => {
            depthEls.forEach((el) => (el.style.transform = ''));
          });
        }

        /* 3D tilt on cards (pointer-driven rotate + glare) */
        const tiltEls = document.querySelectorAll('.tier, .card, .po');
        tiltEls.forEach((el) => {
          el.classList.add('tilt');
          el.addEventListener('pointermove', (ev) => {
            const r = el.getBoundingClientRect();
            const px = (ev.clientX - r.left) / r.width;
            const py = (ev.clientY - r.top) / r.height;
            el.style.setProperty('--ry', ((px - 0.5) * 9).toFixed(2) + 'deg');
            el.style.setProperty('--rx', ((0.5 - py) * 9).toFixed(2) + 'deg');
            el.style.setProperty('--gx', (px * 100).toFixed(1) + '%');
            el.style.setProperty('--gy', (py * 100).toFixed(1) + '%');
            el.classList.add('is-tilting');
          });
          el.addEventListener('pointerleave', () => {
            el.style.removeProperty('--rx');
            el.style.removeProperty('--ry');
            el.classList.remove('is-tilting');
          });
        });

        /* Flowing pipeline connectors + floating portal */
        document.querySelectorAll('.pipeline svg line').forEach((l) => l.classList.add('pipe-flow'));
        const portal = document.querySelector('.portal');
        if (portal) portal.classList.add('float-soft');

        /* Directional reveals for two-column sections */
        document.querySelectorAll('.split').forEach((sp) => {
          const cols = Array.from(sp.children).filter((c) => c.classList.contains('reveal'));
          cols.forEach((c, i) => c.classList.add(i === 0 ? 'r-left' : 'r-right'));
        });
      }
    </script>

