---
// EE Metro — digital sales systems for food manufacturers & distributors (NY/NJ)
// Single-page landing. Pure static output, no client frameworks.
const BOOK_URL = '#book'; // placeholder — set the real booking link before launch

// Contact + platform
const PHONE = '(646) 580-2939';
const PHONE_HREF = 'tel:+16465802939';
const PLATFORM_URL = 'https://ai.eemetro.com';

// Package pricing + checkout links (single source of truth for the billing toggle).
// Annual card shows the effective monthly rate; note shows the billed total + savings.
// 3-month links exist too (unused for now):
//   starter 3mo $3,600  https://buy.stripe.com/cNi8wOaun24h1u1c8i9sk0a
//   growth  3mo $7,000  https://buy.stripe.com/dRmbJ08mf7oB8Wt0pA9sk0h
//   revenue 3mo $12,000 https://buy.stripe.com/dRm9AS0TN7oBdcJb4e9sk0e
const TIERS = {
  starter: {
    mPrice: '$1,200', mLink: 'https://buy.stripe.com/cNi4gybyr5gt3C9goy9sk0b',
    aPrice: '$1,017', aLink: 'https://buy.stripe.com/bJe7sKcCv7oBfkR4FQ9sk0c',
    aNote: 'billed annually ($12,200/yr) — save $2,200',
  },
  growth: {
    mPrice: '$2,500', mLink: 'https://buy.stripe.com/14AcN4cCv5gt3C9b4e9sk0g',
    aPrice: '$2,250', aLink: 'https://buy.stripe.com/bJe5kC31VeR3goV6NY9sk0i',
    aNote: 'billed annually ($27,000/yr) — save $3,000',
  },
  revenue: {
    mPrice: '$5,000', mLink: 'https://buy.stripe.com/cNi4gy9qj10d8Wt8W69sk0d',
    aPrice: '$4,750', aLink: 'https://buy.stripe.com/aFa8wO9qjdMZ1u10pA9sk0f',
    aNote: 'billed annually ($57,000/yr) — save $3,000',
  },
};

import { Image, getImage } from 'astro:assets';
import '@fontsource-variable/archivo';
import '@fontsource-variable/figtree';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import heroImg from '../assets/hero-produce-data.jpg';
import problemImg from '../assets/purchasing-manager-warehouse.jpg';
import breadImg from '../assets/bread-production-line.jpg';
import teamImg from '../assets/warehouse-team-clipboards.jpg';
import spiceImg from '../assets/spice-world-map.jpg';

const spiceBg = await getImage({ src: spiceImg, width: 1600, format: 'webp', quality: 60 });

const title = 'Digital Sales Systems for Food Manufacturers & Distributors | EE Metro';
const description =
  'EE Metro builds revenue operations systems for food manufacturers and distributors in New York and New Jersey: capture every inquiry, automate follow-up, and make reordering effortless.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://eemetro.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://eemetro.com/" />
    <meta name="theme-color" content="#175239" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='18' fill='%23175239'/%3E%3Ctext x='50' y='68' font-size='52' font-family='Arial' font-weight='bold' text-anchor='middle' fill='%23E89B2E'%3EE%3C/text%3E%3C/svg%3E" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ProfessionalService',
        name: 'EE Metro',
        url: 'https://eemetro.com/',
        telephone: '+1-646-580-2939',
        description,
        areaServed: ['New York', 'New Jersey'],
        knowsAbout: ['Revenue operations', 'Food manufacturing', 'Food distribution'],
      })}
    />
  </head>

  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <!-- ============ NAV ============ -->
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="#top" aria-label="EE Metro home">
          <span class="brand-mark">EE</span>
          <span class="brand-text">METRO<small>digital sales systems</small></span>
        </a>
        <nav aria-label="Main">
          <a href="#problem">The Problem</a>
          <a href="#system">The System</a>
          <a href="#roi">ROI</a>
          <a href="#packages">Packages</a>
        </nav>
        <a class="nav-phone" href={PHONE_HREF} aria-label={`Call EE Metro at ${PHONE}`}>
          <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z"></path></svg>
          <span>{PHONE}</span>
        </a>
        <a class="btn btn-amber nav-cta" href={BOOK_URL}>Book a Call</a>
      </div>
    </header>

    <main id="top">
      <!-- ============ HERO ============ -->
      <section class="hero" id="hero">
        <div class="hero-media" data-parallax="0.08">
          <Image
            src={heroImg}
            width={1600}
            widths={[800, 1600]}
            sizes="100vw"
            format="webp"
            quality={80}
            alt="Fresh produce on a wholesale counter with a digital ordering and inventory data overlay"
            loading="eager"
            fetchpriority="high"
          />
          <div class="hero-scrim" aria-hidden="true"></div>
        </div>
        <div class="hero-aurora" aria-hidden="true" data-depth="10">
          <span class="blob b1"></span>
          <span class="blob b2"></span>
          <span class="blob b3"></span>
          <span class="hero-grid"></span>
        </div>
        <div class="wrap hero-inner">
          <p class="eyebrow">FOOD MANUFACTURERS &amp; DISTRIBUTORS · NY / NJ</p>
          <h1>Your products move fast.<br />Your sales system should too.</h1>
          <p class="lede">
            We install the digital sales system behind your business: every inquiry captured, every
            follow-up automatic, every reorder effortless. You keep making and moving great food —
            the system keeps the orders coming.
          </p>
          <div class="cta-row">
            <a class="btn btn-amber" href={BOOK_URL}>Book an Intro Call</a>
            <a class="btn btn-ghost" href="#packages">See Packages</a>
          </div>
          <p class="hero-call">or call <a href={PHONE_HREF}>{PHONE}</a> — talk to a person today.</p>
          <p class="hero-note mono">Built for bakeries, beverage brands, specialty importers &amp; wholesale distributors.</p>
        </div>
      </section>

      <!-- ============ PROBLEM ============ -->
      <section class="problem" id="problem">
        <div class="wrap split">
          <figure class="reveal">
            <Image
              src={problemImg}
              width={1600}
              widths={[800, 1600]}
              sizes="(max-width: 900px) 100vw, 50vw"
              format="webp"
              quality={80}
              alt="Purchasing manager on the phone holding a clipboard between warehouse racking"
              loading="lazy"
            />
            <figcaption class="mono">Sound familiar? Orders by phone, follow-ups on paper.</figcaption>
          </figure>
          <div class="copy reveal">
            <p class="eyebrow">THE PROBLEM</p>
            <h2>Good product. Busy phones. Leaking pipeline.</h2>
            <p>
              Most food businesses we meet run sales the way they did fifteen years ago: inquiries on
              voicemail, price sheets by fax or text, reorders that depend on somebody remembering to
              call. Meanwhile buyers have changed — they research online, they expect an answer the
              same day, and they reorder from whoever makes it easiest.
            </p>
            <ul class="ticks">
              <li>Website inquiries that nobody answers for days</li>
              <li>Follow-up that lives in one salesperson's head</li>
              <li>Regular customers who quietly drift to a competitor</li>
              <li>No numbers on what's working and what isn't</li>
            </ul>
            <p><strong>None of this is a people problem. It's a systems problem</strong> — and systems can be installed.</p>
          </div>
        </div>
      </section>

      <!-- ============ SYSTEM / PIPELINE ============ -->
      <section class="system" id="system">
        <div class="wrap">
          <div class="center-head reveal">
            <p class="eyebrow">THE SYSTEM</p>
            <h2>One pipeline, from first inquiry to standing reorder</h2>
            <p class="sub">
              We connect the pieces you already have — your website, your phones, your customer list —
              into a single pipeline that never forgets to follow up.
            </p>
          </div>

          <!-- Pipeline diagram (inline SVG, palette only) -->
          <div class="pipeline reveal" role="img" aria-label="Pipeline diagram: inquiry captured, automatic follow-up, order confirmed, reorder scheduled">
            <svg viewBox="0 0 920 180" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                  <path d="M0 0L10 5L0 10z" fill="#E89B2E"></path>
                </marker>
              </defs>
              <g font-family="'IBM Plex Mono', monospace" font-size="15" text-anchor="middle">
                <rect x="10" y="55" width="200" height="70" rx="10" fill="#175239"></rect>
                <text x="110" y="85" fill="#F7F6F2">INQUIRY</text>
                <text x="110" y="107" fill="#F7F6F2">CAPTURED</text>

                <line x1="215" y1="90" x2="245" y2="90" stroke="#E89B2E" stroke-width="3" marker-end="url(#arr)"></line>

                <rect x="250" y="55" width="200" height="70" rx="10" fill="#175239"></rect>
                <text x="350" y="85" fill="#F7F6F2">AUTOMATIC</text>
                <text x="350" y="107" fill="#F7F6F2">FOLLOW-UP</text>

                <line x1="455" y1="90" x2="485" y2="90" stroke="#E89B2E" stroke-width="3" marker-end="url(#arr)"></line>

                <rect x="490" y="55" width="200" height="70" rx="10" fill="#175239"></rect>
                <text x="590" y="85" fill="#F7F6F2">ORDER</text>
                <text x="590" y="107" fill="#F7F6F2">CONFIRMED</text>

                <line x1="695" y1="90" x2="725" y2="90" stroke="#E89B2E" stroke-width="3" marker-end="url(#arr)"></line>

                <rect x="730" y="55" width="180" height="70" rx="10" fill="#0E3B27" stroke="#E89B2E" stroke-width="2"></rect>
                <text x="820" y="85" fill="#E89B2E">REORDER</text>
                <text x="820" y="107" fill="#E89B2E">SCHEDULED</text>
              </g>
            </svg>
          </div>

          <div class="grid3">
            <article class="card reveal">
              <h3>Capture</h3>
              <p>Every call, form, and email lands in one place with the buyer's details — no more sticky notes, no more "who was supposed to call them back?"</p>
            </article>
            <article class="card reveal">
              <h3>Convert</h3>
              <p>Quotes, samples, and follow-ups go out on schedule, automatically. Your team steps in when a buyer is ready to talk, not to chase paperwork.</p>
            </article>
            <article class="card reveal">
              <h3>Keep</h3>
              <p>Standing orders, reorder reminders, and win-back outreach run in the background so your best accounts never quietly go cold.</p>
            </article>
          </div>
        </div>
      </section>

      <!-- ============ HOW IT WORKS ============ -->
      <section class="how" id="how">
        <div class="wrap split split-rev">
          <div class="copy reveal">
            <p class="eyebrow">HOW IT WORKS</p>
            <h2>Installed in weeks, not quarters</h2>
            <ol class="steps">
              <li>
                <span class="step-no mono">01</span>
                <div>
                  <h3>Audit</h3>
                  <p>We map how orders actually reach you today — phone, email, walk-in, rep — and find where inquiries and reorders slip through.</p>
                </div>
              </li>
              <li>
                <span class="step-no mono">02</span>
                <div>
                  <h3>Install</h3>
                  <p>We build your pipeline: lead capture, follow-up sequences, order and reorder workflows — connected to the tools your team already uses.</p>
                </div>
              </li>
              <li>
                <span class="step-no mono">03</span>
                <div>
                  <h3>Operate</h3>
                  <p>We run and tune the system month over month, with plain-English reporting so you always know what it's producing.</p>
                </div>
              </li>
            </ol>
          </div>
          <figure class="reveal">
            <Image
              src={teamImg}
              width={1600}
              widths={[800, 1600]}
              sizes="(max-width: 900px) 100vw, 50vw"
              format="webp"
              quality={80}
              alt="Two warehouse workers in hard hats reviewing order sheets on clipboards"
              loading="lazy"
            />
            <figcaption class="mono">Your operation, your process — systematized.</figcaption>
          </figure>
        </div>
      </section>

      <!-- ============ ROI — PURCHASE ORDER ============ -->
      <section class="roi" id="roi">
        <div class="wrap">
          <div class="center-head reveal">
            <p class="eyebrow eyebrow-light">WHAT IT'S WORTH</p>
            <h2 class="on-dark">The math, written the way you already read it</h2>
            <p class="sub on-dark">Illustrative month for a mid-size specialty distributor. Your audit gets real numbers.</p>
          </div>

          <div class="po reveal" id="po">
            <header class="po-head">
              <div>
                <p class="po-brand">EE METRO · REVENUE OPERATIONS</p>
                <p class="mono po-meta">DOC TYPE: WHOLESALE PURCHASE ORDER</p>
              </div>
              <div class="po-no">
                <p class="mono">PO Nº <strong>00-2047</strong></p>
                <p class="mono">TERMS: MONTHLY</p>
              </div>
            </header>

            <table class="po-table">
              <thead>
                <tr>
                  <th scope="col">LINE</th>
                  <th scope="col">DESCRIPTION</th>
                  <th scope="col" class="num">QTY / MO</th>
                  <th scope="col" class="num">VALUE / MO</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="mono">001</td>
                  <td>Website &amp; phone inquiries captured (previously lost)</td>
                  <td class="num mono"><span class="count" data-count="18">0</span></td>
                  <td class="num mono">$<span class="count" data-count="7200">0</span></td>
                </tr>
                <tr>
                  <td class="mono">002</td>
                  <td>Dormant accounts reactivated by win-back sequence</td>
                  <td class="num mono"><span class="count" data-count="6">0</span></td>
                  <td class="num mono">$<span class="count" data-count="9400">0</span></td>
                </tr>
                <tr>
                  <td class="mono">003</td>
                  <td>Reorders placed on schedule (no chasing)</td>
                  <td class="num mono"><span class="count" data-count="42">0</span></td>
                  <td class="num mono">$<span class="count" data-count="15800">0</span></td>
                </tr>
                <tr>
                  <td class="mono">004</td>
                  <td>Office hours returned from manual order entry</td>
                  <td class="num mono"><span class="count" data-count="31">0</span> hrs</td>
                  <td class="num mono">$<span class="count" data-count="1240">0</span></td>
                </tr>
              </tbody>
              <tfoot>
                <tr>
                  <td colspan="3">ESTIMATED MONTHLY IMPACT</td>
                  <td class="num mono total">$<span class="count" data-count="33640">0</span></td>
                </tr>
              </tfoot>
            </table>

            <footer class="po-foot mono">
              <span>AUTHORIZED BY: YOUR NEXT QUARTER</span>
              <span class="po-stamp">APPROVED</span>
            </footer>
          </div>
        </div>
      </section>

      <!-- ============ PACKAGES ============ -->
      <section class="packages" id="packages">
        <div class="wrap">
          <div class="pack-intro split">
            <div class="copy reveal">
              <p class="eyebrow">PACKAGES</p>
              <h2>Start where you are. Grow into the rest.</h2>
              <p class="sub">
                Three levels, one direction: every tier is a working sales system, not a bundle of
                marketing tasks. Move up when the volume justifies it.
              </p>
            </div>
            <figure class="reveal">
              <Image
                src={breadImg}
                width={1600}
                widths={[800, 1600]}
                sizes="(max-width: 900px) 100vw, 50vw"
                format="webp"
                quality={80}
                alt="Loaves of bread moving down an automated bakery production line"
                loading="lazy"
              />
              <figcaption class="mono">Production is systematized. Sales should be too.</figcaption>
            </figure>
          </div>

          <div class="bill-toggle reveal" role="radiogroup" aria-label="Billing period">
            <button type="button" class="bt-opt mono is-active" data-term="m" aria-pressed="true">MONTHLY</button>
            <button type="button" class="bt-opt mono" data-term="a" aria-pressed="false">
              ANNUAL <span class="bt-save">SAVE UP TO 15%</span>
            </button>
          </div>

          <div class="tiers">
            <article class="tier reveal">
              <h3>Starter Growth System</h3>
              <p class="price mono js-price" data-m-price={TIERS.starter.mPrice} data-a-price={TIERS.starter.aPrice}>{TIERS.starter.mPrice}<span>/month</span></p>
              <p class="price-note mono js-price-note" data-m-note="billed monthly" data-a-note={TIERS.starter.aNote}>billed monthly</p>
              <p class="tier-for">For manufacturers, distributors, and food brands that need a professional online presence and a way to capture new business opportunities.</p>
              <ul class="ticks">
                <li>Professional website management</li>
                <li>Search visibility fundamentals</li>
                <li>Local business listing management</li>
                <li>Monthly content updates</li>
                <li>Social media management</li>
                <li>Email newsletter</li>
                <li>Lead capture forms &amp; automatic lead notifications</li>
                <li>Lead source tracking &amp; basic reporting</li>
                <li>Contact database organization</li>
              </ul>
              <p class="outcome"><strong>Outcome:</strong> generate more inquiries and stop losing leads that come through your website.</p>
              <a class="btn btn-green js-buy" data-m-link={TIERS.starter.mLink} data-a-link={TIERS.starter.aLink} href={TIERS.starter.mLink} rel="noopener">Start Here</a>
            </article>

            <article class="tier tier-featured reveal">
              <p class="flag mono">MOST POPULAR</p>
              <h3>Growth Automation System</h3>
              <p class="price mono js-price" data-m-price={TIERS.growth.mPrice} data-a-price={TIERS.growth.aPrice}>{TIERS.growth.mPrice}<span>/month</span></p>
              <p class="price-note mono js-price-note" data-m-note="billed monthly" data-a-note={TIERS.growth.aNote}>billed monthly</p>
              <p class="tier-for">For food companies that already have traffic and customers but need a system to consistently generate and nurture opportunities.</p>
              <ul class="ticks">
                <li>Everything in Starter</li>
                <li>Advanced search visibility &amp; content marketing</li>
                <li>Landing pages for products or distributors</li>
                <li>CRM implementation and management</li>
                <li>Automated lead routing &amp; lead scoring</li>
                <li>Follow-up email and text sequences</li>
                <li>Sales pipeline tracking</li>
                <li>Appointment scheduling automation</li>
                <li>Distributor &amp; customer segmentation</li>
                <li>Performance dashboards &amp; monthly strategy reviews</li>
              </ul>
              <p class="outcome"><strong>Outcome:</strong> convert more prospects into customers while reducing manual sales follow-up.</p>
              <a class="btn btn-amber js-buy" data-m-link={TIERS.growth.mLink} data-a-link={TIERS.growth.aLink} href={TIERS.growth.mLink} rel="noopener">Get Started</a>
            </article>

            <article class="tier reveal">
              <h3>Revenue OS</h3>
              <p class="price mono js-price" data-m-price={TIERS.revenue.mPrice} data-a-price={TIERS.revenue.aPrice}>{TIERS.revenue.mPrice}<span>/month</span></p>
              <p class="price-note mono js-price-note" data-m-note="billed monthly" data-a-note={TIERS.revenue.aNote}>billed monthly</p>
              <p class="tier-for">For established manufacturers, distributors, and multi-location food businesses that want a complete revenue infrastructure.</p>
              <ul class="ticks">
                <li>Everything in Growth</li>
                <li>Customer &amp; distributor ordering portals</li>
                <li>Reorder automation &amp; retention workflows</li>
                <li>Customer lifetime value &amp; health scoring</li>
                <li>Inventory-related workflow integrations</li>
                <li>AI-powered customer support &amp; lead qualification</li>
                <li>Executive revenue dashboards &amp; forecasting</li>
                <li>Multi-brand / multi-location management</li>
                <li>Custom integrations &amp; dedicated account management</li>
              </ul>
              <p class="outcome"><strong>Outcome:</strong> a scalable revenue operating system that increases orders, improves retention, and reduces administrative workload.</p>
              <a class="btn btn-green js-buy" data-m-link={TIERS.revenue.mLink} data-a-link={TIERS.revenue.aLink} href={TIERS.revenue.mLink} rel="noopener">Start Now</a>
            </article>
          </div>

          <!-- Revenue OS portal mockup -->
          <div class="portal-band split">
            <div class="copy reveal">
              <p class="eyebrow">INSIDE REVENUE OS</p>
              <h2>Your customers order like it's 2026</h2>
              <p>
                Revenue OS includes a private ordering portal under your brand: your catalog, your
                prices per account, one-click reorders from order history, and delivery-day cutoffs
                built in. Buyers stop calling to ask "what did we get last time?" — it's on their
                screen.
              </p>
              <ul class="ticks">
                <li>Account-specific catalogs and pricing</li>
                <li>One-click reorder from past invoices</li>
                <li>Standing orders with delivery-day cutoffs</li>
                <li>Every order flows straight into your pipeline</li>
              </ul>
            </div>
            <div class="portal reveal" role="img" aria-label="Mockup of a branded wholesale ordering portal showing catalog items and a one-click reorder panel">
              <div class="portal-chrome" aria-hidden="true">
                <span></span><span></span><span></span>
                <p class="mono">orders.yourbrand.com</p>
              </div>
              <div class="portal-body" aria-hidden="true">
                <aside class="portal-side">
                  <p class="portal-logo">YOUR<br />BRAND</p>
                  <p class="active">Create Order</p>
                  <p>Order History</p>
                  <p>Standing Orders</p>
                  <p>Invoices</p>
                </aside>
                <div class="portal-main">
                  <div class="portal-top mono">
                    <span>NEXT DELIVERY: TUE</span>
                    <span class="portal-cut">ORDER CUTOFF 6:00 PM</span>
                  </div>
                  <div class="portal-row">
                    <span class="sw"></span>
                    <div><p>Sourdough Boule · Case of 12</p><p class="mono sku">SKU 1042 · $38.40</p></div>
                    <button type="button" tabindex="-1">Reorder</button>
                  </div>
                  <div class="portal-row">
                    <span class="sw sw2"></span>
                    <div><p>Cold Brew Concentrate · 4×1 gal</p><p class="mono sku">SKU 2210 · $64.00</p></div>
                    <button type="button" tabindex="-1">Reorder</button>
                  </div>
                  <div class="portal-row">
                    <span class="sw sw3"></span>
                    <div><p>Imported Olive Oil · 6×750 ml</p><p class="mono sku">SKU 3307 · $89.50</p></div>
                    <button type="button" tabindex="-1">Reorder</button>
                  </div>
                  <div class="portal-total mono">
                    <span>3 ITEMS · $191.90</span>
                    <span class="portal-place">PLACE ORDER →</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ FINAL CTA ============ -->
